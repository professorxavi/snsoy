# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Book content — never commit it; ingest reads it from CONTENT_SOURCE_DIR
/content/full/
/data/

/docs/

# Spot-check exports. Content pulled straight out of the database, including
# non-SRD sources, so these are for local inspection only.
/example/

# Ingest and data-validation tooling.
#
# Ingest runs once, ever. Once the books are loaded and dumped to a seed, this
# code is obsolete — every instance thereafter is built by restoring the seed.
# The repo carries only what the app runs long term.
#
# Note that this code exists nowhere else. If it matters to you, back it up
# outside version control before wiping a working copy.
#
# Render-time modules it depends on (tags, dnd, variables, walk) deliberately
# live in src/lib/content/ and ARE committed — the renderer and builder need
# them on every request.
/scripts/ingest/

# Seed dumps.
#
# Ignored wholesale by default because the full-content seed is the entire
# licensed dataset. Only the SRD-only seed is ever committable, and it must be
# allowlisted explicitly once it exists — an ignore rule that lets seeds
# through by default would leak everything on the first careless `git add`.
/seed/*
!/seed/.gitkeep
!/seed/README.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright run artefacts. The report embeds page HTML, which for this app
# means book text, so it must never be committed.
/test-results/
/playwright-report/
/blob-report/
