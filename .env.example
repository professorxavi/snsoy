# Postgres connection. Matches docker-compose.yml defaults.
# Port 5433 is deliberate — it avoids clashing with any Postgres already on 5432.
DATABASE_URL="postgres://snsoy:snsoy@localhost:5433/snsoy"

# Absolute path to a directory of corpus-format JSON content.
# Required only for ingestion; a deployed instance reads from the database.
# The corpus is NEVER committed to this repo — point this at a local copy.
CONTENT_SOURCE_DIR=""
