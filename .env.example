# Password for the Postgres container in docker-compose.yml.
# No default — compose refuses to start without it, on purpose.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(15).toString('base64url'))"
# Keep it alphanumeric or base64url: the value also goes inside DATABASE_URL
# below, where characters like @ : / # and ? change what the URL means.
#
# This only takes effect when the data volume is EMPTY. Changing it against a
# database that already exists does nothing at all. To rotate:
#   docker compose down -v && pnpm db:up && pnpm db:migrate && pnpm db:seed
# The -v is what drops the volume. Without it the old password survives, and so
# does a missing pg_trgm, because the initdb scripts only run on a fresh volume.
POSTGRES_PASSWORD=""

# Postgres connection. The password here must match POSTGRES_PASSWORD above —
# the app checks at startup and refuses to run if they disagree.
# Port 5433 is deliberate — it avoids clashing with any Postgres already on 5432.
DATABASE_URL="postgres://snsoy:PASSWORD@localhost:5433/snsoy"

# Absolute path to a directory of source JSON for the books.
# Required only for ingestion; a deployed instance reads from the database.
# The book data is NEVER committed to this repo — point this at a local copy.
CONTENT_SOURCE_DIR=""

# Absolute path to the matching directory of images.
# Development only. Served by /api/media so images work locally without a CDN.
# Several gigabytes — never committed, never copied into a deployment.
CONTENT_IMAGE_DIR=""

# Base URL of a running instance for the smoke tests in tests/smoke.
# Leave unset and they skip; the rest of the suite needs no server.
# Locally: start `pnpm dev`, then set this to http://localhost:3000
SMOKE_BASE_URL=""

# Origin that relative media paths resolve against.
# Leave unset in development to use the local /api/media route above.
# In production set it to the image bucket's public origin, e.g.
#   NEXT_PUBLIC_IMAGE_BASE_URL="https://images.example.com/"
NEXT_PUBLIC_IMAGE_BASE_URL=""
